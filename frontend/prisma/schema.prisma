datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  onboarded     Boolean   @default(false)
  timezone      String?
  occupation    String?
  motivation          String?
  textingBaseline     String?
  dailySummary        Boolean   @default(true)
  goalReminders       Boolean   @default(true)
  proactiveCheckins   Boolean   @default(true)
  autoMonthlyReport   Boolean   @default(true)
  emergencyEscalation Boolean   @default(false)
  preferredPlatform   String    @default("discord")
  pendingTaskContext  String?
  lastMorningCheckIn  String?
  lastNightCheckIn    String?
  caspianEmailConnectionId String? @unique
  discordId           String?   @unique
  discordConnectCode  String?   @unique
  telegramId          String?   @unique
  telegramConnectCode String?   @unique
  whatsappNum         String?   @unique
  accounts            Account[]
  sessions            Session[]
  messages            Message[]
  sessionLogs         SessionLog[]
  tasks               Task[]
  habitLogs           HabitLog[]
  scheduledHabits     ScheduledHabit[]
  habitExecutions     HabitExecution[]
  emergencyContact    EmergencyContact?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  role      String
  text      String
  createdAt DateTime @default(now())
  processed Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SessionLog {
  id          String   @id @default(cuid())
  userId      String
  overallMood String
  summary     String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  goal        String?
  priority    String    @default("medium")
  dueDate     DateTime?
  completed   Boolean   @default(false)
  status      String    @default("pending")
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HabitLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduledHabit {
  id          String   @id @default(cuid())
  userId      String
  title       String
  time        String   // e.g., "08:00"
  frequency   String   @default("daily") // "daily", "weekends", "weekdays"
  createdAt   DateTime @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions HabitExecution[]
}

model HabitExecution {
  id               String   @id @default(cuid())
  scheduledHabitId String
  userId           String
  status           String   @default("pending") // "pending", "completed", "failed"
  reminderStep     String   @default("initial") // "initial", "followup1", "timeout"
  lastContactedAt  DateTime @default(now())
  dateString       String   // e.g., "2026-08-08" to prevent duplicates for the same day
  createdAt        DateTime @default(now())

  habit ScheduledHabit @relation(fields: [scheduledHabitId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  email     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
